; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CastleUIProject"
run/main_scene="uid://dp5v5vynktsnd"
config/features=PackedStringArray("4.4", "Forward Plus")

[audio]

general/text_to_speech=true
manager/sound/bus="Sound"
manager/sound/pool_1D_size=16
manager/sound/pool_2D_size=16
manager/sound/pool_3D_size=16
manager/sound/max_polyphony=32
manager/music/bus="Music"

[autoload]

SimpleGrass="*res://addons/simplegrasstextured/singleton.tscn"
GlobalMusicPlayer="*res://addons/music_player/script/music_player.gd"

[display]

window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/SceneBuilder/plugin.cfg", "res://addons/music_player/plugin.cfg", "res://addons/prototype_mini_bundle/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/zylann.hterrain/plugin.cfg")

[global_group]

Interactable="anything that can be pushed, but also stood on etc."

